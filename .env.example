# Replace both values before running Docker Compose. Keep this file secret-free.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-unique-database-password

FRONTEND_PORT=8080
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# This example runs over local HTTP. Behind HTTPS, set both secure cookies true,
# SSL redirect true, and proxy SSL header true only when the proxy sets X-Forwarded-Proto.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_PROXY_SSL_HEADER=false
SECURE_HSTS_SECONDS=0

# Optional integrations
GOOGLE_OAUTH_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local development uses Django's console email backend. Configure SMTP for deployment.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ProjectNote <noreply@projectnote.local>